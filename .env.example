OPENAI_API_KEY=
# Online visual review requires an accessible model with image inputs and structured outputs.
OPENAI_MODEL=gpt-5.6-luna
# npm start reads PORT from this file; test runners choose a temporary port.
PORT=3000
# Test runners require BASE_URL to be exported; this file alone does not redirect them.
BASE_URL=http://127.0.0.1:3000
# visual:review and bugs:review read this setting; automatic test reports stay offline.
AI_MODE=offline
