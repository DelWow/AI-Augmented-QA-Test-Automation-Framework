{
  "info": {
    "name": "TaskTracker - Baseline",
    "description": "Baseline API checks: authentication, validation, and a complete task CRUD lifecycle. Run all requests in order with Collection Runner. Each iteration uses a unique demo user and deletes its task. Token and task ID are stored in run-local variables.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:3000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 - Reject unauthenticated access",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/tasks",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.variables.set(\"token\", \"\");",
              "pm.variables.set(\"taskId\", \"\");",
              "pm.variables.set(\"username\", \"postman-baseline-\" + pm.variables.replaceIn(\"{{$guid}}\"));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 401\", () => pm.response.to.have.status(401));",
              "pm.test(\"Response is JSON\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"));",
              "pm.test(\"Error body matches\", () => pm.expect(pm.response.json()).to.deep.equal({\"error\": \"Unauthorized\"}));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 - Reject invalid login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/login",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"wrong-password\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 401\", () => pm.response.to.have.status(401));",
              "pm.test(\"Response is JSON\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"));",
              "pm.test(\"Error body matches\", () => pm.expect(pm.response.json()).to.deep.equal({\"error\": \"Use a nonempty username (max 80 characters) and demo-password\"}));"
            ]
          }
        }
      ]
    },
    {
      "name": "03 - Log in",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/login",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"demo-password\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Response is JSON\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"));",
              "pm.test(\"Login returns a token\", () => {",
              "  const body = pm.response.json();",
              "  pm.expect(body.token).to.be.a(\"string\").and.not.empty;",
              "  pm.variables.set(\"token\", body.token);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "04 - List tasks for new user",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/tasks"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Response is JSON\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"));",
              "pm.test(\"New user has no tasks\", () => pm.expect(pm.response.json()).to.deep.equal([]));"
            ]
          }
        }
      ]
    },
    {
      "name": "05 - Reject missing title",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/tasks",
        "body": {
          "mode": "raw",
          "raw": "{}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 400\", () => pm.response.to.have.status(400));",
              "pm.test(\"Response is JSON\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"));",
              "pm.test(\"Error body matches\", () => pm.expect(pm.response.json()).to.deep.equal({\"error\": \"Title must contain 1\\u2013200 characters; completed must be boolean; unknown fields are rejected\"}));"
            ]
          }
        }
      ]
    },
    {
      "name": "06 - Create task",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/tasks",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Baseline task\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
              "pm.test(\"Response is JSON\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"));",
              "pm.test(\"Created task has a positive integer ID and default completion\", () => {",
              "  const body = pm.response.json();",
              "  pm.expect(body.id).to.be.a(\"number\");",
              "  pm.expect(Number.isSafeInteger(body.id) && body.id > 0).to.equal(true);",
              "  pm.variables.set(\"taskId\", String(body.id));",
              "  pm.expect(body).to.deep.equal({ id: body.id, title: \"Baseline task\", completed: false });",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "07 - Get created task",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/tasks/{{taskId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Response is JSON\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"));",
              "pm.test(\"Task fields match\", () => {",
              "  pm.expect(pm.response.json()).to.deep.equal({",
              "    id: Number(pm.variables.get(\"taskId\")),",
              "    title: \"Baseline task\",",
              "    completed: false",
              "  });",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "08 - List includes created task",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/tasks"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Response is JSON\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"));",
              "pm.test(\"List contains the created task\", () => {",
              "  pm.expect(pm.response.json()).to.deep.equal([",
              "    { id: Number(pm.variables.get(\"taskId\")), title: \"Baseline task\", completed: false }",
              "  ]);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "09 - Update task",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/tasks/{{taskId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Updated baseline task\",\n  \"completed\": true\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Response is JSON\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"));",
              "pm.test(\"Task fields match\", () => {",
              "  pm.expect(pm.response.json()).to.deep.equal({",
              "    id: Number(pm.variables.get(\"taskId\")),",
              "    title: \"Updated baseline task\",",
              "    completed: true",
              "  });",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "10 - Verify update persisted",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/tasks/{{taskId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Response is JSON\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"));",
              "pm.test(\"Task fields match\", () => {",
              "  pm.expect(pm.response.json()).to.deep.equal({",
              "    id: Number(pm.variables.get(\"taskId\")),",
              "    title: \"Updated baseline task\",",
              "    completed: true",
              "  });",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "11 - Delete task",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/tasks/{{taskId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 204\", () => pm.response.to.have.status(204));",
              "pm.test(\"Delete returns an empty body\", () => pm.expect(pm.response.text()).to.equal(\"\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "12 - Deleted task is missing",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/tasks/{{taskId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 404\", () => pm.response.to.have.status(404));",
              "pm.test(\"Response is JSON\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"));",
              "pm.test(\"Error body matches\", () => pm.expect(pm.response.json()).to.deep.equal({\"error\": \"Task not found\"}));"
            ]
          }
        }
      ]
    },
    {
      "name": "13 - Verify cleanup",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/tasks"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Response is JSON\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"));",
              "pm.test(\"Task list is empty after cleanup\", () => pm.expect(pm.response.json()).to.deep.equal([]));"
            ]
          }
        }
      ]
    }
  ]
}
